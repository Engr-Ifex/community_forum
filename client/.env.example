# Community Forum client - environment template
# Copy to `.env` (never committed) and adjust per environment.
#   cp client/.env.example client/.env
#
# Only variables prefixed with VITE_ are exposed to the browser.
# Must include the /api/v1 prefix exposed by the backend.

VITE_API_URL=http://localhost:5000/api/v1

VITE_USER_PASSWORD=
VITE_MODERATOR_PASSWORD=
VITE_ADMIN_PASSWORD=