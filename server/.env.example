# Community Forum server - environment template
# Copy to `.env` (never committed) and adjust per environment.
#   cp server/.env.example server/.env

NODE_ENV=development
PORT=5000

# Local MongoDB. For Atlas use:
#   mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_URI=mongodb://127.0.0.1:27017/community_forum

# Must be a long random string. In production the API demands at least 32
# characters and refuses to boot otherwise.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=1d

# Empty or unset defaults to the /api/v1 prefix.
# Change this only if you deliberately want a different API mount point.
API_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins (CORS).
# In production this MUST list your deployed frontend origin, e.g.
#   CLIENT_URL=https://community-forum.vercel.app
CLIENT_URL=http://localhost:5173

# Rate limiting. Window in ms and max requests per window per IP.
# Production defaults to a 15-minute window and 300 requests when unset.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
